{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/engine-clearance-v1.schema.json",
  "title": "Asset Mania engine clearance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "engine",
    "components",
    "runtime_dependencies",
    "cleared_by",
    "cleared_at",
    "expires_at",
    "clearance_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "asset-mania/engine-clearance"
    },
    "schema_version": {
      "const": "1.0"
    },
    "engine": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "commercial_use",
            "content_sha256",
            "download_receipt_sha256",
            "license_spdx",
            "license_url",
            "name",
            "revision"
          ],
          "properties": {
            "role": {
              "enum": [
                "engine_code"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license_spdx": {
              "type": "string",
              "pattern": "^(CUSTOM|[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(\\s(OR|AND|WITH)\\s[A-Za-z0-9][A-Za-z0-9.+-]{0,63})*)$"
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(/[!-~]*)?$"
            },
            "commercial_use": {
              "enum": [
                "cleared",
                "prohibited",
                "unknown"
              ]
            },
            "download_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "commercial_use",
            "content_sha256",
            "download_receipt_sha256",
            "license_spdx",
            "license_url",
            "name",
            "revision"
          ],
          "properties": {
            "role": {
              "enum": [
                "model_weights"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license_spdx": {
              "type": "string",
              "pattern": "^(CUSTOM|[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(\\s(OR|AND|WITH)\\s[A-Za-z0-9][A-Za-z0-9.+-]{0,63})*)$"
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(/[!-~]*)?$"
            },
            "commercial_use": {
              "enum": [
                "cleared",
                "prohibited",
                "unknown"
              ]
            },
            "download_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "commercial_use",
            "content_sha256",
            "download_receipt_sha256",
            "license_spdx",
            "license_url",
            "name",
            "revision"
          ],
          "properties": {
            "role": {
              "enum": [
                "preprocessing_model"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license_spdx": {
              "type": "string",
              "pattern": "^(CUSTOM|[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(\\s(OR|AND|WITH)\\s[A-Za-z0-9][A-Za-z0-9.+-]{0,63})*)$"
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(/[!-~]*)?$"
            },
            "commercial_use": {
              "enum": [
                "cleared",
                "prohibited",
                "unknown"
              ]
            },
            "download_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "items": false
    },
    "runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commercial_use",
          "content_sha256",
          "download_receipt_sha256",
          "license_spdx",
          "license_url",
          "name",
          "revision"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license_spdx": {
            "type": "string",
            "pattern": "^(CUSTOM|[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(\\s(OR|AND|WITH)\\s[A-Za-z0-9][A-Za-z0-9.+-]{0,63})*)$"
          },
          "license_url": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(/[!-~]*)?$"
          },
          "commercial_use": {
            "enum": [
              "cleared",
              "prohibited",
              "unknown"
            ]
          },
          "download_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cleared_by": {
      "const": "user"
    },
    "cleared_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "clearance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
