{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/provider-evidence-v1.schema.json",
  "title": "Asset Mania provider evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "provider",
    "model_snapshot",
    "sources",
    "retrieved_at",
    "expires_at",
    "content_digest",
    "data_policy",
    "pricing",
    "evidence_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "asset-mania/provider-evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "provider": {
      "const": "openai"
    },
    "model_snapshot": {
      "const": "gpt-image-2-2026-04-21"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "retrieved_at",
          "content_sha256",
          "parser_profile"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://(developers\\.openai\\.com|platform\\.openai\\.com)(/[!-~]*)?$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parser_profile": {
            "const": "openai-gpt-image-2-v1"
          }
        }
      }
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_default",
        "application_state",
        "abuse_monitoring_days",
        "zdr",
        "csam_review_exception",
        "effective_region"
      ],
      "properties": {
        "training_default": {
          "const": "not_used_unless_opted_in"
        },
        "application_state": {
          "const": "none"
        },
        "abuse_monitoring_days": {
          "const": 30
        },
        "zdr": {
          "const": "eligible_with_approval"
        },
        "csam_review_exception": {
          "const": true
        },
        "effective_region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rate_mode",
        "per_million_tokens",
        "output_cost_rows",
        "retrieved_at",
        "content_sha256"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "rate_mode": {
          "const": "standard"
        },
        "per_million_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_input",
            "cached_text_input",
            "image_input",
            "cached_image_input",
            "image_output"
          ],
          "properties": {
            "text_input": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
            },
            "cached_text_input": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
            },
            "image_input": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
            },
            "cached_image_input": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
            },
            "image_output": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
            }
          }
        },
        "output_cost_rows": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "low"
                },
                "size": {
                  "const": "1024x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "low"
                },
                "size": {
                  "const": "1024x1536"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "low"
                },
                "size": {
                  "const": "1536x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "medium"
                },
                "size": {
                  "const": "1024x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "medium"
                },
                "size": {
                  "const": "1024x1536"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "medium"
                },
                "size": {
                  "const": "1536x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "high"
                },
                "size": {
                  "const": "1024x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "high"
                },
                "size": {
                  "const": "1024x1536"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quality",
                "size",
                "usd"
              ],
              "properties": {
                "quality": {
                  "const": "high"
                },
                "size": {
                  "const": "1536x1024"
                },
                "usd": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                }
              }
            }
          ],
          "items": false
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
