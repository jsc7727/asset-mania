{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/approval-receipt-v1.schema.json",
  "title": "Asset Mania approval receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "receipt_id",
    "plan_sha256",
    "gate",
    "issued_at",
    "expires_at",
    "scope",
    "disclosure_digest",
    "issuer_type",
    "acknowledgement_digest",
    "receipt_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "asset-mania/approval-receipt"
    },
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate": {
      "enum": [
        "face_rights",
        "external_egress",
        "paid_compute"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "const": "single_run"
    },
    "disclosure_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuer_type": {
      "const": "user"
    },
    "acknowledgement_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
