{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/manifest-v1.schema.json",
  "title": "Asset Mania run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command",
    "tool_version",
    "created_at",
    "inputs",
    "environment",
    "parameters",
    "capabilities",
    "artifacts",
    "result",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "const": "inspect"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "sha256",
          "byte_size",
          "media_type"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^input-[1-9][0-9]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "unsupported",
            "needs_approval"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "enum": [
              "INPUT_NOT_FOUND",
              "UNSUPPORTED_MEDIA_TYPE",
              "INPUT_UNREADABLE",
              "EXIF_SENSITIVE_METADATA_PRESENT",
              "BLEND_HEADER_INVALID",
              "BLENDER_NOT_FOUND",
              "WORKFLOW_NOT_IMPLEMENTED"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array"
    }
  }
}
