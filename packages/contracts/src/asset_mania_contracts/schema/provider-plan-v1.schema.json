{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/provider-plan-v1.schema.json",
  "title": "Asset Mania provider plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "condition_manifest_sha256",
    "provider",
    "endpoint",
    "model",
    "attachments",
    "prompt_sha256",
    "controls",
    "subject",
    "policy_evidence",
    "cost_estimate",
    "expected_view",
    "required_gates",
    "overwrite_policy",
    "plan_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "asset-mania/provider-plan"
    },
    "schema_version": {
      "const": "1.0"
    },
    "condition_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "const": "openai"
    },
    "endpoint": {
      "const": "/v1/images/edits"
    },
    "model": {
      "const": "gpt-image-2-2026-04-21"
    },
    "attachments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "multipart_field",
            "index",
            "sha256",
            "byte_size",
            "media_type",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "beauty"
            },
            "multipart_field": {
              "const": "image[]"
            },
            "index": {
              "const": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "const": "image/png"
            },
            "upload_eligible": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "multipart_field",
            "index",
            "sha256",
            "byte_size",
            "media_type",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "depth_preview"
            },
            "multipart_field": {
              "const": "image[]"
            },
            "index": {
              "const": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "const": "image/png"
            },
            "upload_eligible": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "multipart_field",
            "index",
            "sha256",
            "byte_size",
            "media_type",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "normal_preview"
            },
            "multipart_field": {
              "const": "image[]"
            },
            "index": {
              "const": 2
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "const": "image/png"
            },
            "upload_eligible": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "multipart_field",
            "index",
            "sha256",
            "byte_size",
            "media_type",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "mask"
            },
            "multipart_field": {
              "const": "image[]"
            },
            "index": {
              "const": 3
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "const": "image/png"
            },
            "upload_eligible": {
              "const": true
            }
          }
        }
      ],
      "items": false
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "size",
        "quality",
        "background",
        "output_format",
        "output_compression",
        "moderation"
      ],
      "properties": {
        "n": {
          "const": 1
        },
        "size": {
          "enum": [
            "1024x1024",
            "1024x1536",
            "1536x1024"
          ]
        },
        "quality": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "background": {
          "enum": [
            "auto",
            "opaque"
          ]
        },
        "output_format": {
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "output_compression": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "moderation": {
          "enum": [
            "auto",
            "low"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "output_format": {
                "const": "png"
              }
            },
            "required": [
              "output_format"
            ]
          },
          "then": {
            "properties": {
              "output_compression": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "output_compression": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      ]
    },
    "subject": {
      "enum": [
        "non_person",
        "synthetic_person",
        "real_person"
      ]
    },
    "policy_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "source_urls",
        "retrieved_at",
        "expires_at",
        "content_digest",
        "training_default",
        "application_state",
        "abuse_monitoring_days",
        "zdr",
        "csam_review_exception",
        "effective_region"
      ],
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(/[!-~]*)?$"
          }
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "training_default": {
          "const": "not_used_unless_opted_in"
        },
        "application_state": {
          "const": "none"
        },
        "abuse_monitoring_days": {
          "const": 30
        },
        "zdr": {
          "const": "eligible_with_approval"
        },
        "csam_review_exception": {
          "const": true
        },
        "effective_region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rate_retrieved_at",
        "rate_digest",
        "text_input_tokens_assumed",
        "image_input_tokens_assumed",
        "cached_text_input_tokens_assumed",
        "cached_image_input_tokens_assumed",
        "n",
        "size",
        "quality",
        "formula",
        "rounding",
        "estimate_uncertainty",
        "estimated_cost",
        "maximum_cost"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "rate_retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "rate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_input_tokens_assumed": {
          "type": "integer",
          "minimum": 0
        },
        "image_input_tokens_assumed": {
          "type": "integer",
          "minimum": 0
        },
        "cached_text_input_tokens_assumed": {
          "const": 0
        },
        "cached_image_input_tokens_assumed": {
          "const": 0
        },
        "n": {
          "const": 1
        },
        "size": {
          "enum": [
            "1024x1024",
            "1024x1536",
            "1536x1024"
          ]
        },
        "quality": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "formula": {
          "const": "uncached_inputs_plus_published_output_row_v1"
        },
        "rounding": {
          "const": "ceiling_6_decimal_places"
        },
        "estimate_uncertainty": {
          "const": "input_tokens_assumed"
        },
        "estimated_cost": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
        },
        "maximum_cost": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
        }
      }
    },
    "expected_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "width",
        "height",
        "media_type",
        "origin",
        "alignment_issuer"
      ],
      "properties": {
        "count": {
          "const": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "origin": {
          "const": "generated"
        },
        "alignment_issuer": {
          "const": "provider"
        }
      }
    },
    "required_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "face_rights",
          "external_egress",
          "paid_compute"
        ]
      }
    },
    "overwrite_policy": {
      "const": "create_only"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "const": "real_person"
          }
        },
        "required": [
          "subject"
        ]
      },
      "then": {
        "properties": {
          "required_gates": {
            "const": [
              "face_rights",
              "external_egress",
              "paid_compute"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "required_gates": {
            "const": [
              "external_egress",
              "paid_compute"
            ]
          }
        }
      }
    }
  ]
}
