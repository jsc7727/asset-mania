{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-mania.dev/schemas/manifest-v2.schema.json",
  "title": "Asset Mania run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "command",
    "stage",
    "tool_version",
    "created_at",
    "inputs",
    "parents",
    "parameters",
    "plan_sha256",
    "environment",
    "capabilities",
    "approvals",
    "artifacts",
    "result",
    "warnings"
  ],
  "properties": {
    "schema_id": {
      "const": "asset-mania/run-manifest"
    },
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "command": {
      "enum": [
        "approval.issue",
        "export",
        "provider.evidence.refresh",
        "scene.condition",
        "scene.plan",
        "scene.preflight",
        "texture.bake",
        "view.generate",
        "view.ingest",
        "view.provider-plan"
      ]
    },
    "stage": {
      "enum": [
        "scene-preflight",
        "scene-plan",
        "provider-evidence",
        "provider-plan",
        "approval-issue",
        "condition",
        "view-ingest",
        "provider-generate",
        "bake",
        "export"
      ]
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "role",
          "sha256",
          "byte_size",
          "media_type",
          "content_origin",
          "sensitivity"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^input-[1-9][0-9]*$"
          },
          "role": {
            "enum": [
              "source_scene",
              "source_view",
              "parent_manifest",
              "workflow_plan",
              "provider_evidence",
              "provider_plan",
              "approval_receipt"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
          },
          "content_origin": {
            "enum": [
              "observed",
              "derived",
              "generated",
              "unknown"
            ]
          },
          "sensitivity": {
            "enum": [
              "portable",
              "user-content",
              "local-sensitive"
            ]
          }
        }
      }
    },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "manifest_sha256",
          "relationship"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "relationship": {
            "enum": [
              "planned_from",
              "evidenced_from",
              "approved_by",
              "conditioned_from",
              "view_from",
              "generated_from",
              "baked_from",
              "exported_from"
            ]
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "plan_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "architecture",
        "python_version",
        "blender"
      ],
      "properties": {
        "operating_system": {
          "enum": [
            "macos",
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "blender": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "version",
                "build_hash",
                "executable_sha256"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
                },
                "version": {
                  "const": "5.2.0"
                },
                "build_hash": {
                  "type": "string",
                  "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
                },
                "executable_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem",
        "blender",
        "provider"
      ],
      "properties": {
        "network": {
          "enum": [
            "denied",
            "approval_gated",
            "explicit_official_hosts"
          ]
        },
        "filesystem": {
          "const": "source_read_staging_write"
        },
        "blender": {
          "enum": [
            "found",
            "not_found",
            "not_required"
          ]
        },
        "provider": {
          "enum": [
            "not_required",
            "not_installed",
            "approval_gated",
            "available"
          ]
        }
      }
    },
    "approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "receipt_sha256",
          "consumption_id",
          "consumed_at"
        ],
        "properties": {
          "gate": {
            "enum": [
              "face_rights",
              "external_egress",
              "paid_compute"
            ]
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consumption_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "consumed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "byte_size",
          "media_type",
          "parents",
          "operation",
          "content_origin",
          "sensitivity",
          "upload_eligible",
          "validation"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
          },
          "parents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "relationship"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "relationship": {
                  "enum": [
                    "consumed",
                    "derived_from",
                    "generated_from"
                  ]
                }
              }
            }
          },
          "operation": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
          },
          "content_origin": {
            "enum": [
              "observed",
              "derived",
              "generated",
              "unknown"
            ]
          },
          "sensitivity": {
            "enum": [
              "portable",
              "user-content",
              "local-sensitive"
            ]
          },
          "upload_eligible": {
            "type": "boolean"
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "status",
              "diagnostics",
              "semantic_digest"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
              },
              "status": {
                "enum": [
                  "valid",
                  "invalid",
                  "incomplete",
                  "unvalidated"
                ]
              },
              "diagnostics": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/diagnostic_code"
                }
              },
              "semantic_digest": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diagnostics",
        "provider_state"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "unsupported",
            "needs_approval",
            "canceled"
          ]
        },
        "diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnostic_code"
          }
        },
        "provider_state": {
          "oneOf": [
            {
              "enum": [
                "planned",
                "approval_required",
                "approved",
                "submitted",
                "running",
                "succeeded",
                "failed",
                "canceled"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/diagnostic_code"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "scene-preflight"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "scene.preflight"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_input_label",
              "profile"
            ],
            "properties": {
              "source_input_label": {
                "type": "string",
                "pattern": "^input-[1-9][0-9]*$"
              },
              "profile": {
                "type": "string",
                "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
              }
            }
          },
          "plan_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "capabilities": {
            "properties": {
              "network": {
                "enum": [
                  "denied",
                  "approval_gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "scene-plan"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "scene.plan"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preflight_manifest_sha256",
              "asset_kind",
              "subject",
              "camera_label",
              "target_label",
              "armature_label",
              "action_label",
              "frame",
              "action_range",
              "resolution",
              "profile"
            ],
            "properties": {
              "preflight_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "asset_kind": {
                "enum": [
                  "object",
                  "character",
                  "face_head"
                ]
              },
              "subject": {
                "enum": [
                  "non_person",
                  "synthetic_person",
                  "real_person",
                  "unknown"
                ]
              },
              "camera_label": {
                "type": "string",
                "pattern": "^(camera|mesh|armature|action|bone)-[1-9][0-9]*$"
              },
              "target_label": {
                "type": "string",
                "pattern": "^(camera|mesh|armature|action|bone)-[1-9][0-9]*$"
              },
              "armature_label": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(camera|mesh|armature|action|bone)-[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "action_label": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(camera|mesh|armature|action|bone)-[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048574
              },
              "action_range": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048574
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resolution": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              },
              "profile": {
                "type": "string",
                "pattern": "^[\\x21-\\x7e][\\x20-\\x7e]*$"
              }
            }
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capabilities": {
            "properties": {
              "network": {
                "enum": [
                  "denied",
                  "approval_gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "provider-evidence"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "provider.evidence.refresh"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "source_hosts",
              "network_action"
            ],
            "properties": {
              "provider": {
                "const": "openai"
              },
              "source_hosts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "developers.openai.com",
                    "platform.openai.com"
                  ]
                }
              },
              "network_action": {
                "const": "explicit"
              }
            }
          },
          "plan_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "capabilities": {
            "properties": {
              "network": {
                "const": "explicit_official_hosts"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "provider-plan"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "view.provider-plan"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_manifest_sha256",
              "evidence_sha256",
              "prompt_sha256",
              "controls"
            ],
            "properties": {
              "condition_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "controls": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "n",
                  "size",
                  "quality",
                  "background",
                  "output_format",
                  "output_compression",
                  "moderation"
                ],
                "properties": {
                  "n": {
                    "const": 1
                  },
                  "size": {
                    "enum": [
                      "1024x1024",
                      "1024x1536",
                      "1536x1024"
                    ]
                  },
                  "quality": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "background": {
                    "enum": [
                      "auto",
                      "opaque"
                    ]
                  },
                  "output_format": {
                    "enum": [
                      "png",
                      "jpeg",
                      "webp"
                    ]
                  },
                  "output_compression": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "moderation": {
                    "enum": [
                      "auto",
                      "low"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "output_format": {
                          "const": "png"
                        }
                      },
                      "required": [
                        "output_format"
                      ]
                    },
                    "then": {
                      "properties": {
                        "output_compression": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "output_compression": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capabilities": {
            "properties": {
              "network": {
                "enum": [
                  "denied",
                  "approval_gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "approval-issue"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "approval.issue"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plan_sha256",
              "gate",
              "expires_at",
              "acknowledgement_digest"
            ],
            "properties": {
              "plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "gate": {
                "enum": [
                  "face_rights",
                  "external_egress",
                  "paid_compute"
                ]
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "acknowledgement_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capabilities": {
            "properties": {
              "network": {
                "enum": [
                  "denied",
                  "approval_gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "condition"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "scene.condition"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow_plan_sha256",
              "rights_receipt_sha256"
            ],
            "properties": {
              "workflow_plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rights_receipt_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capabilities": {
            "properties": {
              "network": {
                "enum": [
                  "denied",
                  "approval_gated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "view-ingest"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "const": "view.ingest"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_manifest_sha256",
              "origin",
              "alignment_attestation_sha256",
              "rights_basis_manifest_sha256"
            ],
            "properties": {
              "condition_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "origin": {
                "enum": [
                  "observed",
                  "derived",
                  "generated",
                  "unknown"
                ]
              },
