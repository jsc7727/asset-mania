          "required": [
            "role",
            "path",
            "sha256",
            "byte_size",
            "media_type",
            "color_space",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "normal_exr"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "sha256": {
              "type": "string",
