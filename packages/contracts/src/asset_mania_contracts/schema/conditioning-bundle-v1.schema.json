            "byte_size",
            "media_type",
            "color_space",
            "upload_eligible"
          ],
          "properties": {
            "role": {
              "const": "beauty_preview"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 0
            },
            "media_type": {
              "const": "image/png"
            },
            "color_space": {
              "const": "srgb"
            },
            "upload_eligible": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "path",
            "sha256",
            "byte_size",
            "media_type",
            "color_space",
            "upload_eligible"
          ],
          "properties": {
